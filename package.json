{
  "name": "ai-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev:server": "npm run dev -w @ai-hub/server",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:server": "npm run build -w @ai-hub/server",
    "build:desktop": "npm run build -w @ai-hub/desktop",
    "build": "npm run build:server && npm run build:desktop",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "package:desktop": "npm run build:desktop && npm run package -w @ai-hub/desktop",
    "package:server": "npm run build:server && node scripts/package-server.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:updater": "node scripts/smoke-updater.mjs",
    "example": "node scripts/create-example.mjs",
    "icons": "node scripts/create-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "esbuild": "^0.25.0",
    "playwright": "1.64.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "yazl": "^3.3.1"
  }
}
