{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {"module": "ESNext", "moduleResolution": "Bundler", "noEmit": true, "jsx": "react-jsx", "isolatedModules": true, "incremental": true, "plugins": [{"name": "next"}]},
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "electron/**/*.ts", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
