{
  "name": "@ai-hub/desktop",
  "version": "26.10.12",
  "private": true,
  "description": "AI Hub Windows skill manager",
  "author": "AI Hub",
  "main": "dist/main.cjs",
  "scripts": {
    "dev:renderer": "next dev --port 3001",
    "build": "next build && node ../../scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-log": "^5.4.0",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@ai-hub/shared": "*",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5"
  },
  "build": {
    "appId": "com.aihub.desktop",
    "productName": "AI Hub",
    "directories": {
      "output": "../../artifacts/desktop"
    },
    "files": [
      "dist/**/*",
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AI-Hub-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "language": "2052"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:3000/updates/win-x64/"
      }
    ]
  }
}
